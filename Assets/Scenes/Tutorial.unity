  m_GameObject: {fileID: 2008241584}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44a2b19809ed4254cbee74bd04c48ca6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 6031556089942846563}
  guideArrow: {fileID: 1836807166}
  guideArrowHeightOffset: 2
  guideArrowOrbitRadius: 1.5
  introSlides:
  - text: "Es war einmal eine Welt, in der alles einen eigenen Klang hatte. Der Wind
      summte, die Fl\xFCsse sangen, und selbst die Steine brummten leise im Takt.
      Man nannte sie Harmonia."
    images:
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  - text: "Wer den Rhythmus der Welt h\xF6ren konnte, konnte ihn auch lenken. Diese
      Menschen nannte man Rhythmanten. Mit jedem Ton, den sie perfekt im Takt spielten,
      formten sie Magie."
    images:
    - {fileID: 56165584, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  - text: Im Herzen von Harmonia stand der Ewige Taktgeber. Er gab der ganzen Welt
      ihren Rhythmus vor, Tag und Nacht, seit Anbeginn der Zeit.
    images:
    - {fileID: -439970112, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 831436490, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 56165584, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  - text: "Doch eines Nachts verstummte er. Ein schriller, falscher Ton zerriss die
      Stille, und der Taktgeber zerbrach in unz\xE4hlige Splitter."
    images:
    - {fileID: -439970112, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 831436490, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 56165584, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  - text: "Seitdem liegt die Dissonanz \xFCber dem Land. Die Gesch\xF6pfe, die sie
      ber\xFChrt, verlieren ihren Takt und werden wild und feindselig. W\xE4lder,
      W\xFCsten und St\xE4dte versinken nach und nach im Chaos."
    images:
    - {fileID: -439970112, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 831436490, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 56165584, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  - text: "Die meisten Rhythmanten sind verschwunden. Doch in einer kleinen Stube
      sa\xDF ein junger Komponist, der den alten Takt noch immer h\xF6ren konnte,
      leise, aber deutlich. Du."
    images:
    - {fileID: -439970112, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 831436490, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 56165584, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  - text: "In derselben Nacht landete ein Splitter des Taktgebers vor deinen F\xFC\xDFen.
      Als du ihn ber\xFChrt hast, durchstr\xF6mte dich die Musik der alten Welt.
      Der Splitter hatte dich gew\xE4hlt."
    images:
    - {fileID: -439970112, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 831436490, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 56165584, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  - text: Aber Musik allein besiegt die Dissonanz nicht. Bevor du dich hinauswagst,
      musst du lernen, deinen Takt zu halten, deine Kraft zu lenken und dich zu verteidigen.
    images:
    - {fileID: -439970112, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 831436490, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 56165584, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  - text: "Hier, auf diesem alten \xDCbungsplatz der Rhythmanten, beginnt deine Reise.
      Finde die Splitter, stelle den Ewigen Taktgeber wieder her und bring Harmonia
      seinen Rhythmus zur\xFCck."
    images:
    - {fileID: -439970112, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 272584051, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 831436490, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    - {fileID: 56165584, guid: a48f6e74edc4fd649bbf6e5f5a507903, type: 3}
    voiceClip: {fileID: 0}
  introPanel: {fileID: 1210769642}
  introImageContainer: {fileID: 2002889023}
  introText: {fileID: 1048791286}
  introContinuePrompt: {fileID: 1303252693}
  introImageFadeDuration: 0.5
  introVoiceVolume: 1
  steps:
  - text: Willkommen in Rhythmancy
    advanceMode: 0
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 1
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal: []
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0.5
  - text: Bewege dich mit WASD in die Markierte Zone
    advanceMode: 2
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal: []
    targetArea: {fileID: 1402467585}
    targetAreaRadius: 1.5
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0.5
  - text: Sehr Gut
    advanceMode: 0
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal: []
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0.5
  - text: Probiere nun die Puppe zu treffen indem du U perfekt beim Beat triffst
    advanceMode: 3
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 2
    marker: {fileID: 0}
    uiElementsToReveal:
    - {fileID: 925600034195436190}
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 5039138488286988605}
    thrownObjectSprite: {fileID: -302779026, guid: aef4a2c559fc05649afac4e9999b73f0, type: 3}
    thrownObjectDamage: 10
    thrownObjectFlightDuration: 0.5
  - text: "Der Gegner hat vor seinem Tot etwas nach dir geworfen und dir schaden
      gemacht, die Gr\xFCne Leiste zeigt dir an, wie viel Leben du hast. Ist diese
      Leiste leer, ist es vorbei."
    advanceMode: 0
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal:
    - {fileID: 3884049097479037335}
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0
  - text: "Zudem Hat der Gegner eine M\xFCnze fallen gelassen, du kannst jederzeit
      rechts oben die Anzahl deiner gesammelten M\xFCnzen sehen. Diese brauchst du,
      um dich zu verbessern."
    advanceMode: 0
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal:
    - {fileID: 1777275164630608520}
    - {fileID: 7881773815320843706}
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0
  - text: Die blaue Leiste ist dein Mana
    advanceMode: 0
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal:
    - {fileID: 5607750509738364593}
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0
  - text: "Das sind deine Karten, sie k\xF6nnen dich st\xE4rken, heilen oder dir
      eine kurze pause geben. Nutze deine Heilkarte indem du \"1\" dr\xFCckst um
      dich zu Heilen."
    advanceMode: 4
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal:
    - {fileID: 5872831624212195548}
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0
  - text: "Jetzt bist du wieder vollgeheilt. Wie du gemerkt hast hat dich die Karte
      zwar geheilt aber auch mana verbraucht. Dr\xFCcke wieder \"1\" damit die karte
      wieder inaktiv wird. Dadurch f\xFCllt sich dein mana wieder auf"
    advanceMode: 4
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal: []
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0
  - text: "Du hast das Tutoial abgeschlossen! Dr\xFCcke unten auf Verlassen um in
      die Sichere Zone zu kommen. Dort kannst du dich verbessern und weiterspielen."
    advanceMode: 4
    dialoguePanelPosition: {fileID: 0}
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal: []
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0
  dialoguePanel: {fileID: 43445180}
  dialogueText: {fileID: 1995456049}
  continuePromptUI: {fileID: 1355591807}
